Options -Indexes

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteRule ^api/reels$ https://first-interior.vercel.app/api/reels [R=307,L,QSA]
  RewriteRule ^api/reel-poster$ https://first-interior.vercel.app/api/reel-poster [R=307,L,QSA]
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>
