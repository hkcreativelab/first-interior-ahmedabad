{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist/client",
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://api.interior-elegance.vercel.app/:path*"
    },
    {
      "source": "/:path((?!\\.).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    }
  ]
}
