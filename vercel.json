{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist/client",
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/((?!api/|.*\\.).*)",
      "destination": "/api/render?_pathname=$1"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    }
  ]
}
