{
  "version": 2,
  "installCommand": "npm install --include=optional && npm install --include=optional --prefix frontend",
  "buildCommand": "cd frontend && npm run build",
  "outputDirectory": "frontend/dist/client",
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/((?!api/|.*\\.).*)",
      "destination": "/api/render?_pathname=$1"
    }
  ]
}
